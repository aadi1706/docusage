# LLM
OPENAI_API_KEY=your_openai_key_here
# OR use HuggingFace Inference Endpoints (free tier available)
HF_API_TOKEN=your_hf_token_here

# Vector DB - Qdrant Cloud (free tier: 1GB)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_key_here

# LLOps - Langfuse (free self-host or cloud)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Experiment Tracking - Weights & Biases
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=docusage

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/docusage

# App
APP_ENV=development
LOG_LEVEL=INFO

# Eval thresholds (used by GitHub Actions eval gate)
RAGAS_FAITHFULNESS_THRESHOLD=0.82
RAGAS_CONTEXT_PRECISION_THRESHOLD=0.75
RAGAS_ANSWER_RELEVANCY_THRESHOLD=0.80
